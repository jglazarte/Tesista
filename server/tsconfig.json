{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "../dist-server",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../src/db.ts",
    "../src/citekey.ts",
    "../src/link-parser.ts",
    "../src/fts.ts",
    "../src/cascade.ts",
    "../src/integrity.ts",
    "../src/backup.ts",
    "../src/export.ts",
    "../src/csl.ts",
    "../src/pandoc.ts",
    "../src/openalex.ts",
    "../src/crossref.ts",
    "../src/bibtex.ts",
    "../src/types.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-server", "../src/editor", "../src/index.ts"]
}
